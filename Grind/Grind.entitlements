<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app writes the widget snapshot here; the widget extension reads it.
	     This identifier must match CoffeeKit's AppGroup.identifier exactly.
	     App Groups require a paid Apple Developer account on a real device;
	     the Simulator works without one. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.haxsh.grind</string>
	</array>
</dict>
</plist>
